                            "Indore": { crop: "Soybean", min: 0.18, max: 0.28 },
                            "Muzaffarpur": { crop: "Litchi 🍒", min: 0.25, max: 0.35 },
                            "Thanjavur": { crop: "Rice 🌾", min: 0.30, max: 0.45 },
                            "Guwahati": { crop: "Tea 🍃", min: 0.30, max: 0.45 },
                            "Srinagar": { crop: "Apple 🍎", min: 0.22, max: 0.32 }
                        };

                        async function fetchAgriIntelligence() {
                            try {
                                let city = "<%= user?.district %>".trim();
                                if (!city || city.includes("<" + "%")) city = "Nagpur";


                                let moisture;

                                /* ===== STEP 1: USE HARD CODED DATA ===== */
                                if (HARD_CODED_SOIL_DATA[city]) {
                                    moisture = HARD_CODED_SOIL_DATA[city];
                                } else {
                                    // API fallback (rare case)
                                    const geoRes = await fetch(
                                        `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`
                                    );
                                    const geoData = await geoRes.json();
                                    const { latitude, longitude } = geoData.results[0];

                                    const res = await fetch(
                                        `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&hourly=soil_moisture_0_to_7cm&timezone=auto`
                                    );
                                    const data = await res.json();
                                    moisture = data.hourly.soil_moisture_0_to_7cm[new Date().getHours()];
                                }


                                /* ================= UI ELEMENTS ================= */
                                const statusEl = document.getElementById("soil-status");
                                const detailEl = document.getElementById("soil-detail");
                                const cropEl = document.getElementById("recommended-crop");
                                const soilCard = document.getElementById("soil-card");

                                /* ================= NORMAL CROP (FALLBACK) ================= */
                                let normalCrop;
                                if (moisture >= 0.35) normalCrop = "Rice / Sugarcane";
                                else if (moisture > 0.18) normalCrop = "Cotton / Soybean";
                                else normalCrop = "Millets / Sorghum";

                                /* ================= SMART FAMOUS CROP LOGIC ================= */
                                let finalCrop = normalCrop;

                                if (FAMOUS_CROPS_BY_CITY[city]) {
                                    const { crop, min, max } = FAMOUS_CROPS_BY_CITY[city];

                                    if (moisture >= min && moisture <= max) {
                                        finalCrop = crop; // ✅ Famous crop wins
                                    }
                                }

                                /* ================= UI STYLE ================= */
                                if (moisture >= 0.34) {
                                    statusEl.innerText = "High";
                                    detailEl.innerText = "Moisture Rich";

                                } else if (moisture > 0.18) {
                                    statusEl.innerText = "Optimal";
                                    detailEl.innerText = "Balanced Soil";

                                } else {
                                    statusEl.innerText = "Low";
                                    detailEl.innerText = "Dry / Loamy";

                                }

                                cropEl.innerText = finalCrop;

                            } catch (err) {
                                console.error("KrushiMitra Error:", err);
                                document.getElementById("soil-status").innerText = "Unavailable";
                            }
                        }

                        fetchAgriIntelligence();
                    });
                </script>
</body>

</html>