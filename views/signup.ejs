<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - KRUSHIMITRA</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <%- include("./partials/tailwind") %>

        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Inter', 'sans-serif'],
                        },
                        colors: {
                            brand: {
                                green: '#047857', // Emerald 700
                                light: '#D1FAE5', // Emerald 100
                                dark: '#064E3B',  // Emerald 900
                            }
                        }
                    }
                }
            }
        </script>
        <style>
            body {
                font-family: 'Inter', sans-serif;
            }

            /* Custom scrollbar for form area if needed */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            /* Loading spinner */
            .spinner {
                border: 2px solid #f3f4f6;
                border-top: 2px solid #047857;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                animation: spin 0.6s linear infinite;
            }

            @keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }
        </style>
        <style>
    @keyframes popIn {
        0% {
            transform: scale(0.8) translateX(100%);
            opacity: 0;
        }

        50% {
            transform: scale(1.05) translateX(0);
        }

        100% {
            transform: scale(1) translateX(0);
            opacity: 1;
        }
    }

    @keyframes popOut {
        0% {
            transform: scale(1) translateX(0);
            opacity: 1;
        }

        100% {
            transform: scale(0.8) translateX(100%);
            opacity: 0;
        }
    }

    .agri-progress {
        animation: agriProgress 5s linear forwards;
    }

    @keyframes agriProgress {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }
</style>
</head>

<body class="bg-white">

    <div id="agri-alerts" class="fixed top-4 right-4 z-[100] space-y-3 w-[360px] max-w-[90vw]">


        <!-- Error Alert -->
        <% if (locals.error) { %>
            <div id="agri-error"
                class="bg-white rounded-xl shadow-xl border-2 border-red-200 overflow-hidden transform transition-all duration-300"
                role="alert" style="animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)">

                <!-- Header with icon -->
                <div
                    class="bg-gradient-to-r from-red-50 to-red-100 px-4 py-3 border-b border-red-200 flex items-center">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center shadow-sm">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <p class="ml-3 text-sm font-bold text-red-900">Request Failed</p>
                    <button onclick="removeAlert('agri-error')"
                        class="ml-auto text-red-400 hover:text-red-600 focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Content -->
                <div class="px-4 py-3">
                    <p class="text-sm text-gray-700">
                        <%= locals.error %>
                    </p>
                </div>

                <!-- Progress bar -->
                <div class="h-1 bg-red-500 agri-progress"></div>
            </div>
            <% } %>

                <!-- Success Alert -->
                <% if (locals.success) { %>
                    <div id="agri-success"
                        class="bg-white rounded-xl shadow-xl border-2 border-emerald-200 overflow-hidden transform transition-all duration-300"
                        role="alert" style="animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)">

                        <!-- Header with icon -->
                        <div
                            class="bg-gradient-to-r from-emerald-50 to-green-100 px-4 py-3 border-b border-emerald-200 flex items-center">
                            <div class="w-8 h-8 bg-emerald-600 rounded-lg flex items-center justify-center shadow-sm">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <p class="ml-3 text-sm font-bold text-emerald-900">Success!</p>
                            <button onclick="removeAlert('agri-success')"
                                class="ml-auto text-emerald-400 hover:text-emerald-600 focus:outline-none">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <!-- Content -->
                        <div class="px-4 py-3">
                            <p class="text-sm text-gray-700">
                                <%= locals.success %>
                            </p>
                        </div>

                        <!-- Progress bar -->
                        <div class="h-1 bg-emerald-600 agri-progress"></div>
                    </div>
                    <% } %>

    </div>

    <div class="min-h-screen flex">

        <div class="hidden lg:flex w-1/2 bg-brand-dark relative items-center justify-center overflow-hidden">
            <img src="https://images.unsplash.com/photo-1605000797499-95a51c5269ae?q=80&w=2071&auto=format&fit=crop"
                class="absolute inset-0 w-full h-full object-cover opacity-40" alt="Farming Field">

            <div class="relative z-10 text-white p-12 max-w-lg">
                <div class="flex items-center gap-3 mb-6">
                    <div class="bg-white/10 backdrop-blur-sm p-2 rounded-xl border border-white/20 inline-block">
                        <img src="/logo.png" alt="KRUSHIMITRA Logo" class="h-12 w-auto">
                    </div>
                </div>
                <h2 class="text-3xl font-semibold mb-4">Empowering Farmers with Intelligence.</h2>
                <p class="text-emerald-100 text-lg leading-relaxed">
                    Access real-time crop analytics, government schemes, and market rates tailored for the Vidarbha
                    region.
                </p>
            </div>
        </div>

        <div
            class="w-full lg:w-7/12 flex flex-col justify-center py-12 px-6 sm:px-12 lg:px-24 bg-gray-50 overflow-y-auto">

            <div class="w-full max-w-lg mx-auto">

                <h2 class="text-3xl font-bold text-gray-900 mb-2">Create Account</h2>
                <p class="text-gray-500 mb-8">Join our community of smart farmers.</p>

                <form action="/user/signup" class="space-y-5" method="post" autocomplete="off">

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input name="fullName" type="text"
                            class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input name="email" type="text"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition"
                                placeholder="abc@gmail.com">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                            <input name="password" type="password"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition"
                                placeholder="••••••••">
                        </div>
                    </div>

                    <div class="border-t border-gray-200 my-4"></div>
                    <div class="border-t border-gray-200 my-4"></div>
                    <div class="border-t border-gray-200 my-4"></div>
                    <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-3">Farm Details</p>

                    <div class="mb-4 md:w-1/3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Pin Code</label>
                        <div class="relative">
                            <input id="pincode" name="pincode" type="text" maxlength="6" pattern="[0-9]*"
                                inputmode="numeric"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition"
                                placeholder="440001">
                            <div id="pincode-loader" class="hidden absolute right-4 top-3.5">
                                <div class="spinner"></div>
                            </div>
                            <i id="pincode-icon"
                                class="fa-solid fa-map-pin absolute right-4 top-3.5 text-gray-400 text-sm"></i>
                        </div>
                        <p id="pincode-error" class="hidden text-xs text-red-500 mt-1"></p>
                        <p id="pincode-success" class="hidden text-xs text-green-600 mt-1"></p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                            <input id="state" name="state" type="text"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition bg-gray-50"
                                placeholder="e.g. Maharashtra" readonly>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">District</label>
                            <input id="district" name="district" type="text"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition bg-gray-50"
                                placeholder="e.g. Nagpur" readonly>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Taluka</label>
                            <input id="region" name="region" type="text"
                                class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition bg-gray-50"
                                placeholder="e.g. Katol" readonly>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Farm Area (Acres)</label>
                            <div class="relative">
                                <input name="farmArea" type="number"
                                    class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition"
                                    placeholder="e.g. 5.5">
                                <span class="absolute right-4 top-3 text-gray-400 text-sm">Acres</span>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-brand-green hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green transition duration-200 mt-6">
                        Create Account
                    </button>

                </form>

                <p class="mt-8 text-center text-sm text-gray-600">
                    Already have an account?
                    <a href="/user/signin" class="font-bold text-brand-green hover:text-brand-dark">Sign In</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        const pincodeInput = document.getElementById('pincode');
        const stateInput = document.getElementById('state');
        const districtInput = document.getElementById('district');
        const regionInput = document.getElementById('region');
        const loader = document.getElementById('pincode-loader');
        const icon = document.getElementById('pincode-icon');
        const errorMsg = document.getElementById('pincode-error');
        const successMsg = document.getElementById('pincode-success');

        let debounceTimer;

        pincodeInput.addEventListener('input', function (e) {
            const pincode = e.target.value;

            // Clear previous messages
            errorMsg.classList.add('hidden');
            successMsg.classList.add('hidden');

            // Clear fields if pincode is less than 6 digits
            if (pincode.length < 6) {
                stateInput.value = '';
                districtInput.value = '';
                regionInput.value = '';
                return;
            }

            // Only proceed if exactly 6 digits
            if (pincode.length === 6) {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetchPincodeData(pincode);
                }, 500);
            }
        });

        async function fetchPincodeData(pincode) {
            // Show loader
            loader.classList.remove('hidden');
            icon.classList.add('hidden');

            try {
                const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                const data = await response.json();

                // Hide loader
                loader.classList.add('hidden');
                icon.classList.remove('hidden');
                if (data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
                    // Find if any post office has BranchType 'Sub Post Office'
                    const subPostOffice = data[0].PostOffice.find(po => po.BranchType === 'Sub Post Office');

                    // Use the sub post office if found, otherwise use the first one
                    const postOffice = subPostOffice || data[0].PostOffice[0];

                    stateInput.value = postOffice.State || '';
                    districtInput.value = postOffice.District || '';
                    regionInput.value = postOffice.Block || '';

                    // Show success message
                    successMsg.textContent = '✓ Location details fetched successfully';
                    successMsg.classList.remove('hidden');
                } else {
                    // Show error
                    errorMsg.textContent = 'Invalid pincode. Please check and try again.';
                    errorMsg.classList.remove('hidden');

                    // Clear fields
                    stateInput.value = '';
                    districtInput.value = '';
                    regionInput.value = '';
                }
            } catch (error) {
                console.error('Error fetching pincode data:', error);

                // Hide loader
                loader.classList.add('hidden');
                icon.classList.remove('hidden');

                // Show error
                errorMsg.textContent = 'Failed to fetch location. Please try again.';
                errorMsg.classList.remove('hidden');

                // Clear fields
                stateInput.value = '';
                districtInput.value = '';
                regionInput.value = '';
            }
        }
    </script>
        <script>
        function removeAlert(alertId) {
            const alert = document.getElementById(alertId);
            if (alert) {
                alert.style.animation = 'popOut 0.3s ease-out forwards';
                setTimeout(() => alert.remove(), 300);
            }
        }

        // Auto-dismiss after 5 seconds
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(() => {
                const errorAlert = document.getElementById('agri-error');
                if (errorAlert) removeAlert('agri-error');
            }, 5000);

            setTimeout(() => {
                const successAlert = document.getElementById('agri-success');
                if (successAlert) removeAlert('agri-success');
            }, 5000);
        });
    </script>


</body>

</html>