<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Krushimitra - Crop Selection</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <%- include("./partials/tailwind") %>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            fontFamily: {
                                sans: ['Inter', 'sans-serif'],
                            },
                            brand: {
                                light: "#d1fae5",
                                DEFAULT: "#059669",
                                dark: "#064e3b",
                                accent: "#10b981",
                                green: '#047857', // Emerald 700
                                light: '#D1FAE5', // Emerald 100
                                dark: '#064E3B',  // Emerald 900
                            },
                        },
                    },
                },
            };
        </script>

        <style>
            @import url(imageurl);

            body {
                font-family: "Inter", sans-serif;
            }

            .fade-in {
                animation: fadeIn 0.5s ease-in-out;
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .loader {
                border: 3px solid #f3f3f3;
                border-top: 3px solid #059669;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                animation: spin 1s linear infinite;
            }

            @keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }
        </style>
</head>

<body class="bg-gray-50 text-gray-800">
    <nav class="w-full bg-white py-4 px-6 md:px-12 flex justify-between items-center shadow-sm sticky top-0 z-50">
        <div class="flex items-center cursor-pointer" style="object-fit: cover;">
            <img src="/logo.png" alt="Krushimitra Logo" class="h-12" />
        </div>

        <div class="flex items-center gap-6">
            <a href="/" class="text-brand-green  hidden md:block">Home</a>
            <a href="/about" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">About</a>
            <a href="/contact" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Contact</a>

            <button id="langToggle"
                class="border border-brand-green text-brand-green px-4 py-1 rounded-full text-sm font-medium hover:bg-brand-light transition">
                English / हिंदी
            </button>

            <% if (locals.user) { %>
                <a href="/user/profile" class="flex items-center gap-3 cursor-pointer group">
                    <div class="text-right hidden sm:block">

                    </div>
                    <div
                        class="w-9 h-9 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center font-semibold text-sm group-hover:bg-emerald-200 transition-colors border-2 border-green-900">
                        <% const names=user.fullName.split(' ');
        const initials = names.length > 1 
            ? names[0][0] + names[names.length - 1][0] 
            : names[0].slice(0, 2);
    %>
    <%= initials.toUpperCase() %>
</div>
                </a>

                <% } else { %>
                    <!-- Show login button when not logged in -->
                    <a href="/user/signin"
                        class="bg-brand-green text-white px-6 py-2 rounded-lg font-medium hover:bg-brand-dark transition shadow-lg shadow-emerald-200 inline-block text-center">
                        Login
                    </a>
                    <% } %>
        </div>
    </nav>
<!-- Floating Go Back Button -->



    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col items-center justify-center min-h-[80vh]">
        
        <!-- Selection View -->
        <div id="selection-view" class="w-full max-w-md bg-white rounded-lg shadow-xl overflow-hidden font-sans">
           <div class="bg-brand-dark px-6 py-4 relative">
    <h2 class="text-white font-bold text-lg tracking-wide text-center">
        Select Crop Details
    </h2>
</div>


            <div class="p-6">
                <div class="mb-8">
                    <label class="block text-gray-700 font-semibold mb-2 text-sm">Select Crop</label>
                    <div class="relative">
                        <select id="crop-select"
                            class="block w-full px-3 py-2.5 text-gray-600 bg-white border border-gray-300 rounded hover:border-brand-DEFAULT focus:outline-none focus:ring-1 focus:ring-brand-DEFAULT focus:border-brand-DEFAULT transition-colors appearance-none cursor-pointer">
                            <option value="">Choose a crop...</option>
                        </select>
                        <div
                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                            <i class="fa-solid fa-angle-down text-sm"></i>
                        </div>
                    </div>
                </div>

                <div class="flex gap-4">
                    <button onclick="cancelSelection(); window.location.href='/'"
                        class="w-1/2 py-2.5 px-4 bg-white border border-gray-300 rounded text-gray-700 font-semibold hover:bg-gray-50 transition-colors">
                        Cancel
                    </button>
                    <button onclick="submitSelection()" id="submitbtn"
                        class="w-1/2 py-2.5 px-4 text-white rounded font-semibold transition-colors shadow-sm"
                        style="background-color: #059669">
                        Submit
                    </button>
                </div>
            </div>
        </div>

        <!-- Details View -->
        <div id="details-view" class="hidden w-full fade-in relative">
            <button onclick="goBack()"
                class="group flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-900 transition-colors bg-white px-4 py-2 rounded-full shadow-sm border border-emerald-100 z-10">
                <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                Back to Selection
            </button>

            <!-- Loading State -->
            <div id="loading-state" class="hidden mt-8 flex flex-col items-center justify-center py-20">
                <div class="loader mb-4"></div>
                <p class="text-gray-600 font-medium">Loading crop details...</p>
            </div>

            <!-- Content -->
            <div id="crop-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8 mt-4">
                <div class="lg:col-span-5 space-y-6">
                    <div
                        class="h-[300px] w-full rounded-2xl overflow-hidden shadow-lg shadow-emerald-100/50 border border-emerald-100 relative group z-0">
                        <img id="detail-image" src="" alt="Crop Image"
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
                    </div>

                    <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-6 relative z-10">
                        <div class="mb-6">
                            <span
                                class="text-xs font-bold text-brand-DEFAULT uppercase tracking-wider mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-seedling"></i> Common Name
                            </span>
                            <h2 id="detail-name" class="text-4xl font-extrabold text-gray-900 leading-tight">
                                Crop Name
                            </h2>
                        </div>

                        <div class="bg-emerald-50 rounded-xl p-5 border border-emerald-100 flex items-center gap-4">
                            <div
                                class="bg-emerald-800 h-12 w-12 rounded-lg flex items-center justify-center text-white text-xl shadow-md shrink-0">
                                <i class="fa-solid fa-seedling"></i>
                            </div>

                            <div>
                                <p class="text-sm font-bold text-emerald-800 uppercase tracking-wide">
                                    Scientific Name
                                </p>
                                <p id="detail-sci" class="text-xl font-medium text-emerald-900 italic mt-0.5">
                                    Loading...
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-8 sticky top-24">
                        <h3
                            class="text-2xl font-bold text-gray-900 mb-8 flex items-center gap-3 pb-4 border-b border-gray-100">
                            <span
                                class="bg-brand-light text-brand-dark w-10 h-10 rounded-full flex items-center justify-center text-lg">
                                <i class="fa-solid fa-list-check"></i>
                            </span>
                            Farming Process Guide
                        </h3>

                        <div id="process-content" class="space-y-0"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script type="module">
        // ---------- DATA ----------
        const crops = [
            // Cereals & Millets
            "Rice",
            "Wheat",
            "Maize",
            "Barley",
            "Sorghum",
            "Pearl Millet",
            "Finger Millet",
            "Foxtail Millet",
            "Little Millet",
            "Kodo Millet",
            "Barnyard Millet",
            "Proso Millet",
            "Brown Top Millet",

            // Pulses
            "Chickpea",
            "Pigeon Pea",
            "Green Grad",
            "Black Gram",
            "Lentil",
            "Field Pea",
            "Cowpea",
            "Horse Gram",
            "Moth Bean",
            "Rajma",
            "Broad Bean",
            "Lima Bean",
            "Adzuki Bean",

            // Oilseeds
            "Groundnut",
            "Mustard",
            "Rapeseed",
            "Soybean",
            "Sunflower",
            "Sesame",
            "Safflower",
            "Linseed",
            "Castor Seed",
            "Niger Seed",
            "Oil Palm",
            "Coconut",

            // Sugar & Starch Crops
            "Sugarcane",
            "Sugar Beet",
            "Sweet Potato",
            "Cassava",
            "Potato",

            // Fibre Crops
            "Cotton",
            "Jute",
            "Mesta",
            "Flax",
            "Hemp",
            "Sisal",
            "Ramie",

            // Plantation Crops
            "Tea",
            "Coffee",
            "Rubber",
            "Cocoa",
            "Arecanut",
            "Cashew",
            "Coconut",

            // Spices & Condiments
            "Black Pepper",
            "White Pepper",
            "Cardamom",
            "Large Cardamom",
            "Clove",
            "Cinnamon",
            "Nutmeg",
            "Mace",
            "Ginger",
            "Turmeric",
            "Dry Chilli",
            "Green Chilli",
            "Coriander",
            "Cumin",
            "Fennel",
            "Fenugreek",
            "Mustard Greens",
            "Garlic",
            "Onion",
            "Bay Leaf",
            "Star Anise",
            "Vanilla",
            "Saffron",

            // Vegetables
            "Tomato",
            "Brinjal",
            "Cabbage",
            "Cauliflower",
            "Okra",
            "Bottle Gourd",
            "Bitter Gourd",
            "Ridge Gourd",
            "Sponge Gourd",
            "Pumpkin",
            "Cucumber",
            "Carrot",
            "Radish",
            "Turnip",
            "Beetroot",
            "Spinach",
            "Fenugreek Leaves",
            "Amaranthus",
            "Drumstick",
            "French Bean",
            "Cluster Bean",
            "Peas",
            "Capsicum",
            "Broccoli",
            "Zucchini",
            "Lettuce",
            "Celery",
            "Asparagus",

            // Fruits
            "Mango",
            "Banana",
            "Apple",
            "Orange",
            "Sweet Lime",
            "Lemon",
            "Grapes",
            "Guava",
            "Papaya",
            "Pineapple",
            "Watermelon",
            "Muskmelon",
            "Pomegranate",
            "Jackfruit",
            "Litchi",
            "Pear",
            "Peach",
            "Plum",
            "Cherry",
            "Strawberry",
            "Blueberry",
            "Raspberry",
            "Kiwi",
            "Fig",
            "Date Palm",
            "Amla",
            "Custard Apple",
            "Sapota (Chikoo)",
            "Dragon Fruit",
            "Avocado",

            // Fodder Crops
            "Berseem",
            "Lucerne",
            "Napier Grass",
            "Guinea Grass",
            "Sudan Grass",
            "Fodder Maize",
            "Fodder Sorghum",
            "Cowpea (Fodder)",

            // Medicinal & Aromatic Plants
            "Aloe Vera",
            "Ashwagandha",
            "Tulsi",
            "Lemongrass",
            "Citronella",
            "Isabgol",
            "Senna",
            "Mint",
            "Vetiver",
            "Kalmegh",
        ];

        // ---------- DOM ELEMENTS ----------
        const cropSelect = document.getElementById("crop-select");
        const selectionView = document.getElementById("selection-view");
        const detailsView = document.getElementById("details-view");
        const loadingState = document.getElementById("loading-state");
        const cropContent = document.getElementById("crop-content");
        const detailName = document.getElementById("detail-name");
        const detailSci = document.getElementById("detail-sci");
        const detailImage = document.getElementById("detail-image");
        const processContent = document.getElementById("process-content");

        // ---------- POPULATE DROPDOWN ----------
        function populateCrops() {
            cropSelect.innerHTML = ' <option value="">Choose a crop...</option>';
            crops.forEach((crop) => {
                const option = document.createElement("option");
                option.value = crop;
                option.textContent = crop;
                cropSelect.appendChild(option);
            });
        }
        async function getCropImage(cropName) {
            try {
                const res = await fetch(
                    `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(cropName)}`
                );

                if (!res.ok) throw new Error("Wiki fetch failed");

                const data = await res.json();

                if (data.thumbnail?.source) {
                    return data.thumbnail.source;
                }

                // 🌾 Public fallback image (always available)
                return "https://dummyimage.com/600x400/14532d/ffffff&text=SORRY,WE ARE UNABLE TO FETCH YOUR IMAGE.";

            } catch (error) {
                console.error(error);

                return "https://dummyimage.com/600x400/14532d/ffffff&text=SORRY,WE ARE UNABLE TO FETCH YOUR IMAGE.";


            }
        }



        // ---------- AI FUNCTION ----------
        async function loadCropDetails(cropName) {
            try {
                const response = await fetch(
                    "https://openrouter.ai/api/v1/chat/completions",
                    {
                        method: "POST",
                        headers: {
                            Authorization:
                                "Bearer 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",
                            "Content-Type": "application/json",
                            "HTTP-Referer": window.location.origin,
                            "X-Title": "Krushimitra Crop Guide",
                        },
                        body: JSON.stringify({
                            model: "arcee-ai/trinity-large-preview:free",
                            messages: [
                                {
                                    role: "system",
                                    content:
                                        "You are an agricultural expert. Always respond in valid JSON only.",
                                },
                                {
                                    role: "user",
                                    content: `Return ONLY valid JSON.

                            {
                            "scientificName": "",
                            "steps": [
                            {"title": "", "description": ""},
                            "imageurl":""
                            ]
                            }

                            Crop: ${cropName}
                            Include 8–9 farming steps of the given crop and each step have 2-3 lines `,
                                },
                            ],
                            temperature: 0.8,
                        }),
                    },
                );

                const data = await response.json();

                let text = data.choices[0].message.content;
                let cleanedText = text.replace(/```json|```/g, "").trim();

                const cropData = JSON.parse(cleanedText);
                return cropData;
            } catch (err) {
                console.error("OpenRouter error:", err);
                return {
                    scientificName: "Not available",
                    steps: [
                        {
                            title: "Error",
                            description: "Currently we are unable to fetch data from AI .Please try again later.",
                        },
                    ],
                };
            }
        }

        // ---------- RENDER FARMING STEPS ----------
        function renderFarmingSteps(steps) {
            processContent.innerHTML = "";

            steps.forEach((step, index) => {
                const stepDiv = document.createElement("div");
                stepDiv.className =
                    "border-l-4 border-brand-DEFAULT pl-6 pb-8 relative";

                stepDiv.innerHTML = `
                            <div class="absolute -left-4 top-0 w-8 h-8 rounded-full 
               bg-emerald-800 text-white text-sm 
               flex items-center justify-center font-bold shadow-lg">
                                ${index + 1}
                            </div>

                            <h4 class="font-bold text-lg text-gray-900 mb-2">
                                ${step.title}
                            </h4>
                            <p class="text-gray-600 leading-relaxed">
                                ${step.description}
                            </p>
                            `;


                processContent.appendChild(stepDiv);
            });
        }

        // ---------- SUBMIT SELECTION ----------
        window.submitSelection = async function () {
            const selectedCrop = cropSelect.value;

            if (!selectedCrop) {
                alert("Please select a crop first!");
                return;
            }

            // Show details view with loading state
            selectionView.style.display = "none";
            detailsView.classList.remove("hidden");
            loadingState.classList.remove("hidden");
            cropContent.classList.add("hidden");

            // Set crop name immediately
            detailName.innerText = selectedCrop;
            detailSci.innerText = "Loading...";

            // Set a generic crop image

            // Load AI data
            const cropData = await loadCropDetails(selectedCrop);

            detailImage.src = await getCropImage(selectedCrop);
            detailImage.alt = selectedCrop;

            // Update UI with loaded data
            detailSci.innerText = cropData.scientificName;
            renderFarmingSteps(cropData.steps);

            // Hide loading, show content
            loadingState.classList.add("hidden");
            cropContent.classList.remove("hidden");
        };

        // ---------- CANCEL SELECTION ----------
        window.cancelSelection = function () {
            cropSelect.value = "";
        };

        // ---------- GO BACK ----------
        window.goBack = function () {
            detailsView.classList.add("hidden");
            selectionView.style.display = "block";
            cropSelect.value = "";
        };

        // ---------- INITIALIZE ----------
        document.addEventListener("DOMContentLoaded", () => {
            populateCrops();
        });
    </script>
                            <%- include("./partials/googletranslate") %>
</body>

</html>