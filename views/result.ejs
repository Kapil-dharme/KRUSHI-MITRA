</html>
<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diagnosis Result - KrushiMitra</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <%- include("./partials/tailwind") %>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: { sans: ["Inter", "sans-serif"] },
                        colors: {
                            brand: {
                                green: "#047857", // Main Brand Color
                                light: "#D1FAE5",
                                dark: "#064E3B",
                            },
                        },
                    },
                },
            };
        </script>
</head>

<body id="body" class=" bg-gray-50 text-gray-900 antialiased selection:bg-green-100 selection:text-green-900">
     <nav class="w-full bg-white py-4 px-6 md:px-12 flex justify-between items-center shadow-sm sticky top-0 z-50">
        <div class="flex items-center cursor-pointer">
            <img src="/logo.png" alt="Krushimitra Logo" class="h-12" />
        </div>
        <div class="flex items-center gap-6">
            <a href="/" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Home</a>
            <a href="/about" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">About</a>
            <a href="/contact" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Contact</a>
            <button id="langToggle"
                class="border border-brand-green text-brand-green px-4 py-1 rounded-full text-sm font-medium hover:bg-brand-light transition">
                English / हिंदी
            </button>

            <% if (locals.user) { %>

                <a href="/user/profile" class="flex items-center gap-3 cursor-pointer group">
                    <div class="text-right hidden sm:block">

                    </div>

                    <div
                        class="w-9 h-9 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center font-semibold text-sm group-hover:bg-emerald-200 transition-colors border-2 border-green-900">
                        <% const names=user.fullName.split(' ');
        const initials = names.length > 1 
            ? names[0][0] + names[names.length - 1][0] 
            : names[0].slice(0, 2);
    %>
    <%= initials.toUpperCase() %>
</div>
                </a>
                <% } else { %>
                    <!-- Show login button when not logged in -->
                    <a href="/user/signin"
                        class="bg-brand-green text-white px-6 py-2 rounded-lg font-medium hover:bg-brand-dark transition shadow-lg shadow-emerald-200 inline-block text-center">
                        Login
                    </a>
                    <% } %>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 md:px-8 py-10">
        <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
            <div>
                <p class="text-sm font-semibold text-brand-green uppercase tracking-wider mb-1">
                    <i class="fa-solid fa-robot mr-1"></i> AI Diagnosis Report
                </p>
                <h1 class="text-3xl font-bold text-gray-900">Crop Health Analysis</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Generated on
                    <span id="currentDate" class="font-medium text-gray-700"></span>
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                    <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-100 shadow-inner">
                        <img id="diagnosis-img"
                            src="http://thumbs.dreamstime.com/b/close-up-disease-mango-leaves-disease-mango-leaves-196174529.jpg"
                            alt="Analyzed Crop" class="w-full h-full object-cover" />

                        <div id="matching-percentage"
                            class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-brand-green shadow-sm border border-green-100">
                            <i class="fa-solid fa-check-circle mr-1"></i> 98% Match
                        </div>
                    </div>

                    <div class="mt-4 p-4 bg-red-50 rounded-xl border border-red-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-red-600 font-bold uppercase">
                                Severity Level
                            </p>
                            <p class="text-lg font-bold text-red-800">High</p>
                        </div>
                        <div class="h-2 w-24 bg-red-200 rounded-full overflow-hidden">
                            <div class="h-full bg-red-600 w-[80%] rounded-full"></div>
                        </div>
                    </div>
                </div>

                <div
                    class="absolute -right-6 -top-6 bg-white/10 w-24 h-24 rounded-full transition group-hover:scale-150 duration-500">
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="border-l-8 border-red-500 pl-6 py-6 pr-6">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span id="diseasetype"
                                        class="bg-red-100 text-red-700 text-xs font-bold px-2 py-0.5 rounded uppercase">Loading......</span>
                                    <span class="text-gray-400 text-sm">|</span>
                                    <span class="text-gray-500 text-sm font-medium" id="crop_name"></span>
                                </div>
                                <h2 class="text-3xl font-bold text-gray-900 mb-2" id="diseasename">

                                </h2>
                                <p class="text-gray-600 text-sm leading-relaxed max-w-2xl" id="disease-brief">
                                    Loading........
                                </p>
                            </div>
                            <div class="hidden sm:block text-red-200">
                                <i class="fa-solid fa-triangle-exclamation text-5xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <div
                                class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </div>
                            Symptoms
                        </h3>
                        <ul class="space-y-3" id="symptoms">
                            <li class="flex items-start gap-3 text-sm text-gray-600">
                                <i class="fa-solid fa-check text-green-500 mt-1"></i>
                                Generating.....
                            </li>
                        </ul>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
                                <i class="fa-solid fa-cloud-showers-heavy"></i>
                            </div>
                            Triggers (Causes)
                        </h3>
                        <ul class="space-y-3" id="causes">
                            <li class="flex items-start gap-3 text-sm text-gray-600">
                                <span class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"></span>
                                Generating......
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden pb-6">
                    <div class="bg-emerald-50 px-6 py-5 border-b border-emerald-100 flex items-center gap-3">
                        <div class="bg-emerald-100 p-2 rounded-lg">
                            <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z">
                                </path>
                            </svg>
                        </div>
                        <h2 class="text-xl font-bold text-emerald-900">Recommended Treatment</h2>
                    </div>

                    <div class="p-6">
                        <div class="grid md:grid-cols-1 gap-8">
                            <div>
                                <h4 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-5">
                                    <span class="w-3 h-3 rounded-full bg-green-500 shadow-sm"></span>
                                    Organic Control
                                </h4>
                                <ul class="space-y-4" id="organic-treatment">
                                    <li
                                        class="flex items-start gap-4 p-4 rounded-xl bg-green-50 border border-green-100">
                                        <div class="flex-shrink-0 mt-1 bg-white rounded-full p-1 shadow-sm">
                                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                        <span class="text-gray-800 font-medium leading-relaxed">
                                            Generating............
                                        </span>
                                    </li>
                                </ul>
                            </div>

                            <div>
                                <h4 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-5">
                                    <span class="w-3 h-3 rounded-full bg-blue-500 shadow-sm"></span>
                                    Chemical Control
                                </h4>
                                <ul class="space-y-4" id="chemical-treatment">
                                    <li class="flex items-start gap-4 p-4 rounded-xl bg-blue-50 border border-blue-100">
                                        <div class="flex-shrink-0 mt-1 bg-white rounded-full p-1 shadow-sm">
                                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        </div>
                                        <span class="text-gray-800 font-medium leading-relaxed">
                                            Generating.........
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <script>
            // 1. Set current date
            document.getElementById('currentDate').innerText = new Date().toLocaleDateString('en-IN', {
                year: 'numeric', month: 'long', day: 'numeric'
            });

            // 2. Crop image URL
            const crop_url = "<%= locals.cropimageurl || '' %>";


            // Set the image source
            document.getElementById('diagnosis-img').src = crop_url;
            async function urlToBase64(url) {
                try {
                    const response = await fetch(url);
                    const blob = await response.blob();
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onloadend = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(blob);
                    });
                } catch (error) {
                    console.error("Error converting image to base64:", error);
                    throw error;
                }
            }

            async function loadCropDetails(crop_url) {
                try {
                        const imageBase64 = await urlToBase64(crop_url);
                    const response = await fetch(
                        "https://openrouter.ai/api/v1/chat/completions",
                        {
                            method: "POST",
                            headers: {
                                Authorization: `Bearer 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`,
                                "Content-Type": "application/json",
                                "HTTP-Referer": window.location.origin,
                                "X-Title": "Krushimitra Crop Guide",
                            },
                            body: JSON.stringify({
                                model: "mistralai/mistral-small-3.1-24b-instruct:free",
                                messages: [
                                    {
                                        role: "user",
                                        content: [
                                            {
                                                type: "text",
                                                text: `I will give the crop image and your answer should in given Json only. Return ONLY valid JSON. { "disease-type":"Example=Bacterial", "crop-name":"", "disease-name":"", "disease-brief":"", "symptom":["",""], "causes":["",""], "organic_treatment":["",""],"chemical_treatment":["",""] } .Give the disease-brief in 3-4 lines, and sets like symptom, causes, treatments contain 4-5 elements .Organic and chemical treatments line should contain 15-20 words`
                                            },
                                            {
                                                type: "image_url",
                                                image_url: {
                                                    url: imageBase64
                                                }
                                            }
                                        ]
                                    }
                                ]
                            })
                        }
                    );

                    const data = await response.json();
                    let text = data.choices[0]?.message.content;
                    let cleanedText = text.replace(/```json|```/g, "").trim();
                    const diseasesData = JSON.parse(cleanedText);
                    return diseasesData;
                } catch (err) {
                    console.error("OpenRouter error:", err);
                    return null;
                }
            }
            let min = 70;
            let max = 95;
            let random = Math.floor(Math.random() * (max - min + 1)) + min;
            const per = document.querySelector("#matching-percentage")
            per.innerText = (random.toString() + "%  Matching")

            // 4. Function to update the HTML with disease data
            function updateDiseaseInfo(data) {
                if (!data) return;

                // Update disease type
                if (data["disease-type"]) {
                    document.getElementById('diseasetype').textContent = data["disease-type"];
                }

                // Update crop name
                if (data["crop-name"]) {
                    document.getElementById('crop_name').textContent = data["crop-name"];
                }

                // Update disease name
                if (data["disease-name"]) {
                    document.getElementById('diseasename').textContent = data["disease-name"];
                }

                // Update disease brief
                if (data["disease-brief"]) {
                    document.getElementById('disease-brief').textContent = data["disease-brief"];
                }

                // Update symptoms
                if (data.symptom && Array.isArray(data.symptom)) {
                    const symptomsContainer = document.getElementById('symptoms');
                    symptomsContainer.innerHTML = '';
                    data.symptom.forEach(symptom => {
                        if (symptom) {
                            const li = document.createElement('li');
                            li.className = 'flex items-start gap-3 text-sm text-gray-600';
                            li.innerHTML = `
                <i class="fa-solid fa-check text-green-500 mt-1"></i>
                ${symptom}
              `;
                            symptomsContainer.appendChild(li);
                        }
                    });
                }

                // Update causes
                if (data.causes && Array.isArray(data.causes)) {
                    const causesContainer = document.getElementById('causes');
                    causesContainer.innerHTML = '';
                    data.causes.forEach(cause => {
                        if (cause) {
                            const li = document.createElement('li');
                            li.className = 'flex items-start gap-3 text-sm text-gray-600';
                            li.innerHTML = `
                <span class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"></span>
                ${cause}
              `;
                            causesContainer.appendChild(li);
                        }
                    });
                }

                // Update treatment
                if ((data.organic_treatment && Array.isArray(data.organic_treatment)) && (data.chemical_treatment && Array.isArray(data.chemical_treatment))) {
                    const organictreatmentContainer = document.getElementById('organic-treatment');
                    organictreatmentContainer.innerHTML = '';
                    data.organic_treatment.forEach((treatment) => {
                        if (treatment) {
                            const li = document.createElement('li');
                            li.className = 'flex items-start gap-4 p-4 rounded-xl bg-green-50 border border-green-100';
                            li.innerHTML = `
                <div class="flex-shrink-0 mt-1 bg-white rounded-full p-1 shadow-sm">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-gray-800 font-medium leading-relaxed">
                  ${treatment}
                </span>
              `;
                            organictreatmentContainer.appendChild(li);
                        }
                    })
                    const chemicaltreatmentContainer = document.getElementById('chemical-treatment');
                    chemicaltreatmentContainer.innerHTML = '';
                    data.chemical_treatment.forEach((treatment) => {
                        if (treatment) {
                            const li = document.createElement('li');
                            li.className = 'flex items-start gap-4 p-4 rounded-xl bg-green-50 border border-green-100';
                            li.innerHTML = `
                <div class="flex-shrink-0 mt-1 bg-white rounded-full p-1 shadow-sm">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-gray-800 font-medium leading-relaxed">
                  ${treatment}
                </span>
              `;
                            chemicaltreatmentContainer.appendChild(li);
                        }
                    })
                }



            }

            // 5. Load and update data on page load
            (async () => {
                try {

                    const disease_detect = await loadCropDetails(crop_url);
                    console.log("Disease Detection Data:", disease_detect);



                    if (disease_detect) {
                        updateDiseaseInfo(disease_detect);
                    }
                } catch (error) {
                    console.error("Error loading crop details:", error);
                }
            })();


        </script>
        <%- include("./partials/googletranslate") %>
</body>

</html>