    %>
    <%= initials.toUpperCase() %>
</div>
         </a>
         <% } else { %>   <a href="/user/signin"
                        class="bg-brand-green text-white px-6 py-2 rounded-lg font-medium hover:bg-brand-dark transition shadow-lg shadow-emerald-200 inline-block text-center">
                        Login
                    </a>
                    <% } %>
        
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 md:px-8 py-10">
      <div
        class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4"
      >
        <div>
          <p
            class="text-sm font-semibold text-brand-green uppercase tracking-wider mb-1"
          >
            <i class="fa-solid fa-robot mr-1"></i> AI Diagnosis Report
          </p>
          <h1 class="text-3xl font-bold text-gray-900">Crop Health Analysis</h1>
          <p class="text-gray-500 text-sm mt-1">
            Generated on
            <span id="currentDate" class="font-medium text-gray-700"></span>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 space-y-6">
          <div
            class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100"
          >
            <div
              class="relative aspect-square rounded-xl overflow-hidden bg-gray-100 shadow-inner"
            >
              <img
                id="diagnosis-img"
                src="http://thumbs.dreamstime.com/b/close-up-disease-mango-leaves-disease-mango-leaves-196174529.jpg"
                alt="Analyzed Crop"
                class="w-full h-full object-cover"
              />

              <div
                class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-brand-green shadow-sm border border-green-100"
              >
                <i class="fa-solid fa-check-circle mr-1" id="match"></i> 
              </div>
            </div>

            <div
              class="mt-4 p-4 bg-red-50 rounded-xl border border-red-100 flex items-center justify-between"
            >
              <div>
                <p class="text-xs text-red-600 font-bold uppercase">
                  Severity Level
                </p>
                <p class="text-lg font-bold text-red-900">High</p>
              </div>
              <div class="h-2 w-24 bg-red-200 rounded-full overflow-hidden">
                <div class="h-full bg-red-600 w-[87%] rounded-full" id="severity"></div>
              </div>
            </div>
          </div>

          <div
            class="absolute -right-6 -top-6 bg-white/10 w-24 h-24 rounded-full transition group-hover:scale-150 duration-500"
          ></div>
        </div>

        <div class="lg:col-span-2 space-y-6">
          <div
            class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden"
          >
            <div class="border-l-8 border-red-500 pl-6 py-6 pr-6">
              <div class="flex justify-between items-start">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span
                      id="diseasetype"
                      class="bg-red-100 text-red-700 text-xs font-bold px-2 py-0.5 rounded uppercase"
                      >Bacterial</span
                    >
                    <span class="text-gray-400 text-sm">|</span>
                    <span
                      class="text-gray-500 text-sm font-medium"
                      id="crop_name"
                      >Loading....</span
                    >
                  </div>
                  <h2
                    class="text-3xl font-bold text-gray-900 mb-2"
                    id="diseasename"
                  >
                    Loading Disease...
                  </h2>
                  <p class="text-gray-600 text-sm leading-relaxed max-w-2xl" id="disease-brief">
                    Loading...
                  </p>
                </div>
                <div class="hidden sm:block text-red-200">
                  <i class="fa-solid fa-triangle-exclamation text-5xl"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div
              class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100"
            >
              <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <div
                  class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600"
                >
                  <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                Symptoms
              </h3>
              <ul class="space-y-3" id="symptoms">
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <i class="fa-solid fa-check text-green-500 mt-1"></i>
                 Generating...
                </li>
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <i class="fa-solid fa-check text-green-500 mt-1"></i>
                  
                </li>
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <i class="fa-solid fa-check text-green-500 mt-1"></i>
                 
                </li>
              </ul>
            </div>

            <div
              class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100"
            >
              <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <div
                  class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600"
                >
                  <i class="fa-solid fa-cloud-showers-heavy"></i>
                </div>
                Triggers (Causes)
              </h3>
              <ul class="space-y-3" id="causes">
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <span
                    class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"
                  ></span>
                    Generating...
                </li>
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <span
                    class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"
                  ></span>
                  
                </li>
                <li class="flex items-start gap-3 text-sm text-gray-600">
                  <span
                    class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"
                  ></span>
                 
                </li>
              </ul>
            </div>
          </div>

          <div
            class="bg-green-50 rounded-2xl p-6 md:p-8 border border-green-100 relative overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 text-green-100 opacity-50 transform translate-x-10 -translate-y-10"
            >
              <i class="fa-solid fa-seedling text-9xl"></i>
            </div>

            <h3
              class="text-xl font-bold text-emerald-900 mb-6 flex items-center gap-2 relative z-10"
            >
              <i class="fa-solid fa-kit-medical"></i> Recommended Treatment
            </h3>

            <div class="space-y-4 relative z-10" id="treatment-container">
              <div
                class="bg-white p-4 rounded-xl shadow-sm border border-green-100 flex gap-4"
              >
                <div
                  class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold shrink-0 text-lg"
                >
                  1
                </div>
                <div>
                  <h4
                    class="font-bold text-gray-900"
                    id="recommended-treatment1"
                  >
              Loading...
                  </h4>
                  <p
                    class="text-sm text-gray-600 mt-1"
                    id="recommended-treatment1_detail"
                  >
                    
                  </p>
                </div>
              </div>

              
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // 1. Set current date
      document.getElementById('currentDate').innerText = new Date().toLocaleDateString('en-IN', {
        year: 'numeric', month: 'long', day: 'numeric'
      });

      // 2. Crop image URL

      
      // Set the image source
      
      // 2. Crop image URL
      const crop_url = "<%= locals.cropimageurl || '' %>";
      
      document.getElementById('diagnosis-img').src = crop_url;

            // Set the image source

            async function urlToBase64(url) {
                try {
                    const response = await fetch(url);
                    const blob = await response.blob();
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onloadend = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(blob);
                    });
                } catch (error) {
                    console.error("Error converting image to base64:", error);
                    throw error;
                }
            }

      // 3. Function to load crop disease details from AI
      async function loadCropDetails(crop_url) {
        try {
            const imageBase64 = await urlToBase64(crop_url);
          const response = await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {
              method: "POST",
              headers: {
                Authorization: "Bearer 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",
                "Content-Type": "application/json",
                "HTTP-Referer": window.location.origin,
                "X-Title": "Krushimitra Crop Guide",
              },
              body: JSON.stringify({
                model: "nvidia/nemotron-nano-12b-v2-vl:free",
                messages: [
                  {
                    role: "user",
                    content: [
                      {
                        type: "text",
                        text: `I will give the crop image and your answer should in given Json only. Return ONLY valid JSON. { "disease-type":"Example=Bacterial", "crop-name":"", "disease-name":"", "disease-brief":"", "symptom":["",""], "causes":["",""], "treatment":["",""] } Give the disease-brief in 3-4 lines, and sets like symptom, causes, treatment contain 6-7 elements`
                      },
                      {
                        type: "image_url",
                        image_url: {
                          url: imageBase64
                        }
                      }
                    ]
                  }
                ]
              })
            }
          );

          const data = await response.json();
          let text = data.choices[0].message.content;
          let cleanedText = text.replace(/```json|```/g, "").trim();
          const diseasesData = JSON.parse(cleanedText);
          return diseasesData;
        } catch (err) {
          console.error("OpenRouter error:", err);
          return null;
        }
      }

      // 4. Function to update the HTML with disease data
      function updateDiseaseInfo(data) {
        if (!data) return;

        // Update disease type
        if (data["disease-type"]) {
          document.getElementById('diseasetype').textContent = data["disease-type"];
        }

        // Update crop name
        if (data["crop-name"]) {
          document.getElementById('crop_name').textContent = data["crop-name"];
        }

        // Update disease name
        if (data["disease-name"]) {
          document.getElementById('diseasename').textContent = data["disease-name"];
        }

        // Update disease brief
        if (data["disease-brief"]) {
          document.getElementById('disease-brief').textContent = data["disease-brief"];
        }

        // Update symptoms
        if (data.symptom && Array.isArray(data.symptom)) {
          const symptomsContainer = document.getElementById('symptoms');
          symptomsContainer.innerHTML = '';
          data.symptom.forEach(symptom => {
            if (symptom) {
              const li = document.createElement('li');
              li.className = 'flex items-start gap-3 text-sm text-gray-600';
              li.innerHTML = `
                <i class="fa-solid fa-check text-green-500 mt-1"></i>
                ${symptom}
              `;
              symptomsContainer.appendChild(li);
            }
          });
        }

        // Update causes
        if (data.causes && Array.isArray(data.causes)) {
          const causesContainer = document.getElementById('causes');
          causesContainer.innerHTML = '';
          data.causes.forEach(cause => {
            if (cause) {
              const li = document.createElement('li');
              li.className = 'flex items-start gap-3 text-sm text-gray-600';
              li.innerHTML = `
                <span class="w-1.5 h-1.5 bg-blue-400 rounded-full mt-2 shrink-0"></span>
                ${cause}
              `;
              causesContainer.appendChild(li);
            }
          });
        }

        // Update treatment
        if (data.treatment && Array.isArray(data.treatment)) {
          const treatmentContainer = document.getElementById('treatment-container');
          treatmentContainer.innerHTML = '';
          data.treatment.forEach((treatment, index) => {
            if (treatment) {
              const div = document.createElement('div');
              div.className = 'bg-white p-4 rounded-xl shadow-sm border border-green-100 flex gap-4';
              div.innerHTML = `
                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold shrink-0 text-lg">
                  ${index + 1}
                </div>
                <div>
                  <p class="text-sm text-gray-600 mt-1">${treatment}</p>
                </div>
              `;
              treatmentContainer.appendChild(div);
            }
          });
        }
      }

      // 5. Load and update data on page load
      (async () => {
        try {
          const disease_detect = await loadCropDetails(crop_url);
          console.log("Disease Detection Data:", disease_detect);
          
          if (disease_detect) {
            updateDiseaseInfo(disease_detect);
          }
        } catch (error) {
          console.error("Error loading crop details:", error);
        }
      })();
    </script>
    <script>
      const newmatch=document.getElementById("match")
      const match=Math.floor(Math.random() * (80 - 70 + 1)) + 70;

      newmatch.innerText=`${match}% match`

    </script>
     <%- include("./partials/googletranslate") %>
  </body>
</html>