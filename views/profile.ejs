        </main>
    </div>
    <%- include("./partials/googletranslate") %>
        <script>
            const pincodeInput = document.getElementById('pincode');
            const stateInput = document.getElementById('state');
            const districtInput = document.getElementById('district');
            const regionInput = document.getElementById('region');
            const loader = document.getElementById('pincode-loader');
            const icon = document.getElementById('pincode-icon');
            const errorMsg = document.getElementById('pincode-error');
            const successMsg = document.getElementById('pincode-success');

            let debounceTimer;

            pincodeInput.addEventListener('input', function (e) {
                const pincode = e.target.value;

                // Clear previous messages
                errorMsg.classList.add('hidden');
                successMsg.classList.add('hidden');

                // Clear fields if pincode is less than 6 digits
                if (pincode.length < 6) {
                    stateInput.value = '';
                    districtInput.value = '';
                    regionInput.value = '';
                    return;
                }

                // Only proceed if exactly 6 digits
                if (pincode.length === 6) {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        fetchPincodeData(pincode);
                    }, 500);
                }
            });

            async function fetchPincodeData(pincode) {
                // Show loader
                loader.classList.remove('hidden');
                icon.classList.add('hidden');

                try {
                    const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                    const data = await response.json();

                    // Hide loader
                    loader.classList.add('hidden');
                    icon.classList.remove('hidden');
                    if (data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
                        // Find if any post office has BranchType 'Sub Post Office'
                        const subPostOffice = data[0].PostOffice.find(po => po.BranchType === 'Sub Post Office');

                        // Use the sub post office if found, otherwise use the first one
                        const postOffice = subPostOffice || data[0].PostOffice[0];

                        stateInput.value = postOffice.State || '';
                        districtInput.value = postOffice.District || '';
                        regionInput.value = postOffice.Block || '';

                        // Show success message
                        successMsg.textContent = '✓ Location details fetched successfully';
                        successMsg.classList.remove('hidden');
                    } else {
                        // Show error
                        errorMsg.textContent = 'Invalid pincode. Please check and try again.';
                        errorMsg.classList.remove('hidden');

                        // Clear fields
                        stateInput.value = '';
                        districtInput.value = '';
                        regionInput.value = '';
                    }
                } catch (error) {
                    console.error('Error fetching pincode data:', error);

                    // Hide loader
                    loader.classList.add('hidden');
                    icon.classList.remove('hidden');

                    // Show error
                    errorMsg.textContent = 'Failed to fetch location. Please try again.';
                    errorMsg.classList.remove('hidden');

                    // Clear fields
                    stateInput.value = '';
                    districtInput.value = '';
                    regionInput.value = '';
                }
            }
        </script>
        <script>
            function removeAlert(alertId) {
                const alert = document.getElementById(alertId);
                if (alert) {
                    alert.style.animation = 'popOut 0.3s ease-out forwards';
                    setTimeout(() => alert.remove(), 300);
                }
            }

            // Auto-dismiss after 5 seconds
            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(() => {
                    const errorAlert = document.getElementById('agri-error');
                    if (errorAlert) removeAlert('agri-error');
                }, 1000);

                setTimeout(() => {
                    const successAlert = document.getElementById('agri-success');
                    if (successAlert) removeAlert('agri-success');
                }, 1000);
            });
        </script>
        <script>
            if (window.location.search) {
                const url = new URL(window.location);
                url.search = "";
                window.history.replaceState({}, document.title, url.pathname);
            }
        </script>

        <script>
            function goBack() {
                window.history.back();
            }
        </script>
</body>

</html>