<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile - KRUSHIMITRA</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <%- include("./partials/tailwind") %>

        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ["Inter", "sans-serif"],
                        },
                        colors: {
                            brand: {
                                green: "#059669", // Emerald 600
                                dark: "#064E3B", // Emerald 900
                                light: "#ECFDF5", // Emerald 50
                                accent: "#D97706", // Amber 600 (Harvest color)
                                accentLight: "#FFFBEB", // Amber 50
                            },
                        },
                        backgroundImage: {
                            "nature-gradient":
                                "linear-gradient(to bottom right, #ECFDF5, #F0FDFA, #FFFBEB)",
                            "card-header": "linear-gradient(to right, #059669, #0d9488)",
                        },
                    },
                },
            };
        </script>
        <style>
            body {
                font-family: "Inter", sans-serif;
            }

            /* Custom scrollbar for a polished look */
            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f1f1;
            }

            ::-webkit-scrollbar-thumb {
                background: #10b981;
                border-radius: 4px;
            }

            ::-webkit-scrollbar-thumb:hover {
                background: #059669;
            }
        </style>
        <style>
            @keyframes popIn {
                0% {
                    transform: scale(0.8) translateX(100%);
                    opacity: 0;
                }

                50% {
                    transform: scale(1.05) translateX(0);
                }

                100% {
                    transform: scale(1) translateX(0);
                    opacity: 1;
                }
            }

            @keyframes popOut {
                0% {
                    transform: scale(1) translateX(0);
                    opacity: 1;
                }

                100% {
                    transform: scale(0.8) translateX(100%);
                    opacity: 0;
                }
            }

            .agri-progress {
                animation: agriProgress 5s linear forwards;
            }

            @keyframes agriProgress {
                from {
                    width: 100%;
                }

                to {
                    width: 0%;
                }
            }
        </style>
</head>

<body class="bg-gray-50 text-gray-800 h-screen flex flex-col">
    <nav class="w-full bg-white py-4 px-6 md:px-12 flex justify-between items-center shadow-sm sticky top-0 z-50">
        <div class="flex items-center cursor-pointer">
            <img src="/logo.png" alt="Krushimitra Logo" class="h-12" />
        </div>

        <div class="flex items-center gap-6">
            <a href="/" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Home</a>
            <a href="/about" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">About</a>
            <a href="/contact" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Contact</a>
            <button id="langToggle"
                class="border border-brand-green text-brand-green px-4 py-1 rounded-full text-sm font-medium hover:bg-brand-light transition">
                English / हिंदी
            </button>
            <div class="flex items-center gap-3 cursor-pointer group"></div>
        </div>
    </nav>

    <div class="flex flex-1 overflow-hidden bg-nature-gradient">
        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <button onclick="goBack()"
                class="w-15 group flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-900 transition-colors bg-white px-4 py-2 rounded-full shadow-sm border border-emerald-100 z-10">
                <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                Go Back
            </button>
            <div class="max-w-5xl mx-auto space-y-8 pb-12">
                <header class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <button class="md:hidden text-brand-green bg-white p-2 rounded-lg shadow-sm">
                            <i class="fa-solid fa-bars text-xl"></i>
                        </button>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">My Profile</h2>
                            <p class="text-sm text-gray-500">
                                Manage your farm details and account settings
                            </p>
                        </div>
                    </div>
                    <div
                        class="hidden md:flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-emerald-100">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                        <span class="text-xs text-gray-600 font-medium">
                            Last Update: <%= new Date(user?.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                day: 'numeric' , year: 'numeric' }) %>
                        </span>
                    </div>
                    <a href="/user/logout"
                        class="flex items-center gap-2 bg-red-50 text-red-600 hover:bg-red-100 px-4 py-2 rounded-lg text-sm font-medium transition border border-red-100 shadow-sm">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Logout</span>
                    </a>

                </header>

                <div
                    class="bg-white rounded-2xl shadow-lg shadow-emerald-100/50 border border-emerald-100 overflow-hidden">
                    <div
                        class="px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="bg-white/20 p-2 rounded-lg text-white">
                                <i class="fa-regular fa-id-card"></i>
                            </div>
                            <h3 class="font-bold text-white text-lg">
                                Personal Information
                            </h3>
                        </div>
                    </div>

                    <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label class="block text-xs font-bold text-emerald-700 uppercase mb-2 tracking-wide">Full
                                Name</label>
                            <div class="relative group">
                                <input type="text" value="<%= user?.fullName %>" disabled
                                    class="block w-full px-4 py-3 bg-gray-50 border border-gray-200 text-gray-600 font-semibold rounded-xl focus:outline-none transition group-hover:border-emerald-200" />
                                <div
                                    class="absolute right-4 top-3.5 text-emerald-500/50 bg-emerald-100 p-1 rounded-full w-6 h-6 flex items-center justify-center">
                                    <i class="fa-solid fa-lock text-xs"></i>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-emerald-700 uppercase mb-2 tracking-wide">Email
                                ID</label>
                            <div class="relative group">
                                <input type="text" value="<%= user?.email%>" disabled
                                    class="block w-full px-4 py-3 bg-gray-50 border border-gray-200 text-gray-600 font-semibold rounded-xl focus:outline-none transition group-hover:border-emerald-200" />
