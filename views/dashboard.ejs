                                const statusEl = document.getElementById("soil-status");
                                const detailEl = document.getElementById("soil-detail");
                                const cropEl = document.getElementById("recommended-crop");
                                const soilCard = document.getElementById("soil-card");

                                /* ================= NORMAL CROP (FALLBACK) ================= */
                                let normalCrop;
                                if (moisture >= 0.35) normalCrop = "Rice / Sugarcane";
                                else if (moisture > 0.18) normalCrop = "Cotton / Soybean";
                                else normalCrop = "Millets / Sorghum";

                                /* ================= SMART FAMOUS CROP LOGIC ================= */
                                let finalCrop = normalCrop;

                                if (FAMOUS_CROPS_BY_CITY[city]) {
                                    const { crop, min, max } = FAMOUS_CROPS_BY_CITY[city];

                                    if (moisture >= min && moisture <= max) {
                                        finalCrop = crop; // ✅ Famous crop wins
                                    }
                                }

                                /* ================= UI STYLE ================= */
                                if (moisture >= 0.34) {
                                    statusEl.innerText = "High";
                                    detailEl.innerText = "Moisture Rich";
                                    soilCard.className =
                                        "bg-white p-5 rounded-xl shadow-sm border-l-4 border-blue-500";
                                    detailEl.className =
                                        "inline-block mt-3 bg-blue-50 text-blue-700 text-xs font-semibold px-2.5 py-1 rounded";
                                } else if (moisture > 0.18) {
                                    statusEl.innerText = "Optimal";
                                    detailEl.innerText = "Balanced Soil";
                                    soilCard.className =
                                        "bg-white p-5 rounded-xl shadow-sm border-l-4 border-green-500";
                                    detailEl.className =
                                        "inline-block mt-3 bg-green-50 text-green-700 text-xs font-semibold px-2.5 py-1 rounded";
                                } else {
                                    statusEl.innerText = "Low";
                                    detailEl.innerText = "Dry / Loamy";
                                    soilCard.className =
                                        "bg-white p-5 rounded-xl shadow-sm border-l-4 border-orange-500";
                                    detailEl.className =
                                        "inline-block mt-3 bg-orange-50 text-orange-700 text-xs font-semibold px-2.5 py-1 rounded";
                                }

                                cropEl.innerText = finalCrop;
                            } catch (err) {
                                console.error("KrushiMitra Error:", err);
                                document.getElementById("soil-status").innerText = "Unavailable";
                            }
                        }

                        fetchAgriIntelligence();
                    });
                </script>
                <%- include("./partials/googletranslate") %>
                    <script>
                        function removeAlert(alertId) {
                            const alert = document.getElementById(alertId);
                            if (alert) {
                                alert.style.animation = 'popOut 0.3s ease-out forwards';
                                setTimeout(() => alert.remove(), 300);
                            }
                        }

                        // Auto-dismiss after 5 seconds
                        document.addEventListener('DOMContentLoaded', function () {
                            setTimeout(() => {
                                const errorAlert = document.getElementById('agri-error');
                                if (errorAlert) removeAlert('agri-error');
                            }, 2000);

                            setTimeout(() => {
                                const successAlert = document.getElementById('agri-success');
                                if (successAlert) removeAlert('agri-success');
                            }, 2000);
                        });
                    </script>

                    <script>
                        const cropImageInput = document.getElementById('cropImageInput');
                        const previewImage = document.getElementById('previewImage');
                        const uploadPlaceholder = document.getElementById('uploadPlaceholder');
                        const viewReportBtn = document.getElementById('viewReportBtn');

                        // Preview image when selected
                        cropImageInput.addEventListener('change', function (e) {
                            const file = e.target.files[0];

                            if (file && file.type.startsWith('image/')) {
                                const reader = new FileReader();

                                reader.onload = function (event) {
                                    previewImage.src = event.target.result;
                                    previewImage.classList.remove('hidden');
                                    uploadPlaceholder.classList.add('hidden');
                                };

                                reader.readAsDataURL(file);
                            } else {
                                alert('⚠️ Please upload a valid crop image');
                            }
                        });

                        // Optional: Validate before submit
                        document.getElementById('diseaseForm').addEventListener('submit', function (e) {
                            if (!cropImageInput.files || cropImageInput.files.length === 0) {
                                e.preventDefault();
                                alert('⚠️ Please select a crop image first');
                                return false;
                            }
                        });
                    </script>
