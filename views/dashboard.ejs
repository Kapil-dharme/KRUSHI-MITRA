                <script>
                    // ================================
                    // GLOBAL VARIABLES & API URL
                    // ================================
                    let apiData = [];
                    let allDistricts = [];
                    let selectedDistrict = "<%=user?.district%>";
                    let allCropsData = [];
                    let showAllCrops = false;
                    const API_URL =
                        "https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070?api-key=579b464db66ec23bdd000001634a3f03ce6149eb6de9fd4e8f57efb0&offset=0&limit=9000&format=csv&format=json";

                    // ================================
                    // DOM ELEMENTS
                    // ================================
                    const cropModal = document.getElementById("cropModal");
                    const openBtn = document.getElementById("openCropModal");
                    const closeBtn = document.getElementById("closeModalBtn");
                    const cancelBtn = document.getElementById("cancelBtn");
                    const confirmBtn = document.getElementById("confirmCropBtn");
                    const cropSelect = document.getElementById("cropSelect");
                    const cropForm = document.getElementById("cropForm");
                    const maxPriceInfo = document.getElementById("maxPriceInfo");
                    const modalMaxPrice = document.getElementById("modalMaxPrice");
                    const modalMarketInfo = document.getElementById("modalMarketInfo");
                    const modalDistrictInfo = document.getElementById("modalDistrictInfo");
                    const currentCropDisplay = document.getElementById("currentCropDisplay");
                    const maxPriceDisplay = document.getElementById("maxPriceDisplay");
                    const priceMarketDisplay = document.getElementById("priceMarketDisplay");
                    const displayDistrict = document.getElementById("displayDistrict");
                    const districtLabel = document.getElementById("districtLabel");
                    const mandiTableBody = document.getElementById("mandiTableBody");
                    const tableDistrictName = document.getElementById("tableDistrictName");

                    // ================================
                    // STEP 1: FETCH API DATA
                    // ================================
                    async function fetchAPIData() {
                        try {
                            const res = await fetch(API_URL);
                            const json = await res.json();
                            apiData = json.records;
                            console.log("✅ Total API records fetched:", apiData.length);

                            // populateDistricts();
                            populateCrops() //- Only call this when modal opens, not on page load
                            populateMandiRates();
                            updateDistrictDisplay();
                        } catch (error) {
                            console.error("❌ Error fetching API data:", error);
                            alert("Error loading data. Please refresh the page.");
                        }
                    }

                    // Show loading state
                    openBtn.addEventListener("click", () => {
                        // Reset state
                        cropSelect.innerHTML = "<option>Loading crops...</option>";
                        cropSelect.disabled = true;
                        maxPriceInfo.classList.add("hidden"); // ← ADD THIS
                        districtLabel.textContent = selectedDistrict; // ← ADD THIS

                        // Open modal
                        cropModal.classList.remove("hidden");

                        // Load crops with delay
                        setTimeout(() => {
                            populateCrops();
                            cropSelect.disabled = false;
                        }, 1500);
                    });
                    // ================================
                    // STEP 2: POPULATE DISTRICTS
                    // ================================
                    function populateDistricts() {
                        const districts = [
                            ...new Set(apiData.map((r) => r.district?.trim()).filter(Boolean)),
                        ].sort();

                        allDistricts = districts;
                        console.log("✅ Total unique districts:", districts.length);
                    }

                    // ================================
                    // STEP 3: POPULATE CROPS BY DISTRICT
                    // ================================
                    function populateCrops() {
                        const crops = [
                            ...new Set(
                                apiData
                                    .filter((record) => record.district?.trim() === selectedDistrict)
                                    .map((r) => r.commodity?.trim())
                                    .filter(Boolean),
                            ),
                        ].sort();

                        cropSelect.innerHTML = '<option value="">Select Crop</option>';

                        if (crops.length === 0) {
                            cropSelect.innerHTML +=
                                "<option disabled>No crops available in this district</option>";
                            return;
                        }

                        crops.forEach((crop) => {
                            const option = document.createElement("option");
                            option.value = crop;
                            option.textContent = crop;
                            cropSelect.appendChild(option);
                        });
                    }

                    // ================================
                    // STEP 3B: UPDATE ALL DISTRICT DISPLAYS
                    // ================================
                    function updateDistrictDisplay() {
                        displayDistrict.textContent = selectedDistrict;
                        districtLabel.textContent = selectedDistrict;
                        tableDistrictName.textContent = selectedDistrict;
                        console.log("✅ All district displays updated to:", selectedDistrict);
                    }

                    // ================================
                    // STEP 4: GET DEMAND STATUS
                    // ================================
                    function getDemandStatus(minPrice, maxPrice) {
                        const priceDifference = maxPrice - minPrice;

                        if (priceDifference > 500) {
                            return {
                                status: "High Demand",
                                color: "bg-green-100 text-green-700",
                            };
                        } else if (priceDifference >= 250 && priceDifference <= 500) {
                            return {
                                status: "Stable",
                                color: "bg-yellow-100 text-yellow-700",
                            };
                        } else {
                            return {
                                status: "Falling",
                                color: "bg-red-100 text-red-700",
                            };
                        }
                    }

                    // ================================
                    // STEP 5: POPULATE MANDI RATES TABLE
                    // ================================
                    function populateMandiRates() {
                        const cropsInDistrict = [
                            ...new Set(
                                apiData
                                    .filter((record) => record.district?.trim() === selectedDistrict)
                                    .map((r) => r.commodity?.trim())
                                    .filter(Boolean),
                            ),
                        ].sort();

                        console.log(
                            "✅ Crops in " + selectedDistrict + ":",
                            cropsInDistrict.length,
                        );

                        mandiTableBody.innerHTML = "";
                        tableDistrictName.textContent = selectedDistrict;

                        if (cropsInDistrict.length === 0) {
                            mandiTableBody.innerHTML =
                                '<tr><td colspan="5" class="text-center py-8 text-gray-500">No crops available in this district</td></tr>';
                            return;
                        }

                        allCropsData = [];

                        cropsInDistrict.forEach((crop) => {
                            const cropRecords = apiData.filter(
                                (record) =>
                                    record.district?.trim() === selectedDistrict &&
                                    record.commodity?.trim() === crop,
                            );

                            if (cropRecords.length === 0) return;

                            const varieties = [
                                ...new Set(
                                    cropRecords.map((r) => r.variety?.trim()).filter(Boolean),
                                ),
                            ];
                            const prices = cropRecords
                                .map((r) => Number(r.modal_price))
                                .filter((p) => !isNaN(p));

                            if (prices.length === 0) return;

                            const minPrice = Math.min(...prices);
                            const maxPrice = Math.max(...prices);
                            const variety = varieties.length > 0 ? varieties[0] : "-";
                            const demandStatus = getDemandStatus(minPrice, maxPrice);

                            allCropsData.push({
                                crop: crop,
                                variety: variety,
                                minPrice: minPrice,
                                maxPrice: maxPrice,
                                demandStatus: demandStatus,
                                priceDifference: maxPrice - minPrice,
                            });
                        });

                        // Sort by demand status
                        allCropsData.sort((a, b) => {
                            const demandOrder = { "High Demand": 0, Stable: 1, Falling: 2 };
                            const orderA = demandOrder[a.demandStatus.status];
                            const orderB = demandOrder[b.demandStatus.status];

                            if (orderA !== undefined && orderB !== undefined) {
                                return orderA - orderB;
                            }
                            return b.priceDifference - a.priceDifference;
                        });

                        // Display crops
                        const cropsToDisplay = showAllCrops
                            ? allCropsData
                            : allCropsData.slice(0, 3);

                        cropsToDisplay.forEach((cropData) => {
                            const row = document.createElement("tr");
                            row.className = "hover:bg-gray-50 transition";
                            row.innerHTML = `
                    <td class="px-6 py-4 font-bold text-gray-900">${cropData.crop}</td>
                    <td class="px-6 py-4 text-gray-600">${cropData.variety}</td>
                    <td class="px-6 py-4 text-gray-500">₹${cropData.minPrice.toLocaleString()}</td>
                    <td class="px-6 py-4 text-emerald-600 font-bold">₹${cropData.maxPrice.toLocaleString()}</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${cropData.demandStatus.color}">
                            ${cropData.demandStatus.status}
                        </span>
                    </td>
                `;
                            mandiTableBody.appendChild(row);
                        });

                        // Update "View All" button
                        const viewAllLink = document.querySelector(".mandi-view-all");
                        if (viewAllLink) {
                            if (allCropsData.length > 3) {
                                viewAllLink.style.display = "block";
                                viewAllLink.innerHTML = showAllCrops
                                    ? '<a href="#" class="text-sm text-emerald-600 font-semibold hover:text-emerald-700 transition">View Less ↑</a>'
                                    : '<a href="#" class="text-sm text-emerald-600 font-semibold hover:text-emerald-700 transition">View All →</a>';
                            } else {
                                viewAllLink.style.display = "none";
                            }
                        }

                        console.log("✅ Mandi rates table populated");
                    }

                    // ================================
                    // STEP 6: CALCULATE MAX PRICE
                    // ================================
                    function getMaxPrice(district, crop) {
                        const filteredRecords = apiData.filter((record) => {
                            const recordDistrict = record.district?.trim();
                            const recordCommodity = record.commodity?.trim();
                            return recordDistrict === district && recordCommodity === crop;
                        });

                        if (filteredRecords.length === 0) {
                            return {
                                maxPrice: null,
                                market: null,
                                data: [],
                            };
                        }

                        let maxPrice = 0;
                        let maxMarket = "";

                        filteredRecords.forEach((record) => {
                            const price = Number(record.modal_price);
                            if (price > maxPrice) {
                                maxPrice = price;
                                maxMarket = record.market?.trim();
                            }
                        });

                        return {
                            maxPrice: maxPrice,
                            market: maxMarket,
                            data: filteredRecords,
                        };
                    }

                    // ================================
                    // STEP 7: UPDATE DISPLAY
                    // ================================
                    function updateMaxPriceDisplay(district, crop) {
                        if (!district || !crop) {
                            maxPriceInfo.classList.add("hidden");
                            return;
                        }

                        const result = getMaxPrice(district, crop);

                        if (result.maxPrice === null) {
                            maxPriceInfo.classList.add("hidden");
                            alert(`No data found for ${crop} in ${district}`);
                            return;
                        }

                        // Update modal display
                        maxPriceInfo.classList.remove("hidden");
                        modalMaxPrice.textContent = `₹${result.maxPrice.toLocaleString()}`;
                        modalMarketInfo.textContent = `📍 Market: ${result.market}`;
                        modalDistrictInfo.textContent = `📍 District: ${district}`;

                        // Update dashboard cards
                        currentCropDisplay.textContent = crop;
                        displayDistrict.textContent = district;
                        maxPriceDisplay.textContent = `₹${result.maxPrice.toLocaleString()}`;
                        priceMarketDisplay.textContent = `📍 ${result.market}`;
                    }

                    // ================================
                    // EVENT LISTENERS
                    // ================================

                    // View All / View Less toggle
                    document.addEventListener("click", (e) => {
                        if (e.target.closest(".mandi-view-all a")) {
                            e.preventDefault();
                            showAllCrops = !showAllCrops;
                            populateMandiRates();
                        }
                    });

                    // Crop change listener
                    cropSelect.addEventListener("change", () => {
                        const crop = cropSelect.value;
                        if (crop && selectedDistrict) {
                            updateMaxPriceDisplay(selectedDistrict, crop);
                        }
                    });

                    // Open modal
                    // openBtn.addEventListener("click", () => {
                    //   console.log("✅ Modal opened for district:", selectedDistrict);
                    //   cropSelect.value = "";
                    //   maxPriceInfo.classList.add("hidden");
                    //   districtLabel.textContent = selectedDistrict;
                    //   cropModal.classList.remove("hidden");
                    //   populateCrops();
                    // });

                    // Close modal functions
                    const closeModalFunc = () => {
                        cropModal.classList.add("hidden");
                    };

                    closeBtn.addEventListener("click", closeModalFunc);
                    cancelBtn.addEventListener("click", closeModalFunc);

                    // Close on outside click
                    cropModal.addEventListener("click", (e) => {
                        if (e.target === cropModal) {
                            closeModalFunc();
                        }
                    });

                    // Form submit - CONFIRM CROP
                    cropForm.addEventListener("submit", (e) => {
                        e.preventDefault();
                        const crop = cropSelect.value;

                        if (!crop) {
                            alert("Please select a crop");
                            return;
                        }

                        console.log("✅ Confirm Crop clicked");
                        console.log("📌 District:", selectedDistrict);
                        console.log("🌾 Crop:", crop);

                        // Update the display
                        updateMaxPriceDisplay(selectedDistrict, crop);

                        // Close modal
                        closeModalFunc();
                    });

                    // ================================
                    // INITIALIZE
                    // ================================
                    window.addEventListener("DOMContentLoaded", () => {
                        console.log("🚀 Page loaded - Fetching data...");
                        fetchAPIData();
                    });
                </script>

                <!-- Weather Script -->
                <script>
                    (async function loadWeather() {
                        try {
                            // 1️⃣ City from EJS
                            const city = "<%= user?.district %>";
                            if (!city) throw new Error("Region not available");

                            /* ================= GEO CODING ================= */
                            const geoRes = await fetch(
                                `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`
                            );
                            const geoData = await geoRes.json();

                            if (!geoData.results || geoData.results.length === 0)
                                throw new Error("City not found");

                            const { latitude, longitude, name } = geoData.results[0];

                            /* ================= MET NORWAY (PRIMARY SOURCE) ================= */
                            const norwayRes = await fetch(
                                `https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=${latitude}&lon=${longitude}`,
                                {
                                    headers: {
                                        "User-Agent": "AgriVision/1.0 (contact: demo@example.com)"
                                    }
                                }
                            );
                            const norwayData = await norwayRes.json();

                            const ts = norwayData.properties.timeseries[0];
                            const instant = ts.data.instant.details;

                            const symbol =
                                ts.data.next_1_hours?.summary?.symbol_code || "cloudy";

                            /* ================= OPEN-METEO (FALLBACK TEMP) ================= */
                            let temperature = instant.air_temperature;


                            const meteoRes = await fetch(
                                `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,precipitation&hourly=precipitation_probability&forecast_days=1`
                            );
                            const meteoData = await meteoRes.json();
                            if (temperature === undefined) {
                                temperature = meteoData.current.temperature_2m;
                            }

                            /* ================= WEATHER SYMBOL MAP ================= */
                            const symbolMap = {
                                clearsky_day: "Clear Sky ☀️",
                                clearsky_night: "Clear Night 🌙",
                                partlycloudy_day: "Partly Cloudy ⛅",
                                partlycloudy_night: "Partly Cloudy 🌙",
                                cloudy: "Cloudy ☁️",
                                fog: "Fog 🌫️",
                                lightrain: "Light Rain 🌦️",
                                rain: "Rain 🌧️",
                                heavyrain: "Heavy Rain 🌧️",
                                snow: "Snow ❄️",
                                thunderstorm: "Thunderstorm ⛈️"
                            };

                            /* ================= UI UPDATE ================= */
                            document.getElementById("city").innerText = `${name} Weather`;

                            document.getElementById("temp").innerText =
                                `${Math.round(temperature)}°C`;

                            document.getElementById("condition").innerText =
                                symbolMap[symbol] || "Weather Update";

                            document.getElementById("humidity").innerText =
                                `Humidity: ${instant.relative_humidity}%`;

                            document.getElementById("wind").innerText =
                                `Wind: ${instant.wind_speed} km/h`;
                            document.getElementById("precipitation").innerText =
                                `${meteoData.current.precipitation || 0} mm`;

                        } catch (err) {
                            console.error("Weather error:", err.message);
                        }


                    })();
                </script>

