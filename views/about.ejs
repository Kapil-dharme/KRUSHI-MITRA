<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - KRUSHIMITRA</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include("./partials/tailwind") %>

        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Inter', 'sans-serif'],
                        },
                        colors: {
                            brand: {
                                green: '#047857', // Emerald 700
                                light: '#D1FAE5', // Emerald 100
                                dark: '#064E3B',  // Emerald 900
                            }
                        }
                    }
                }
            }
        </script>
        <style>
            body {
                font-family: 'Inter', sans-serif;
            }
        </style>
        <style>
            @keyframes popIn {
                0% {
                    transform: scale(0.8) translateX(100%);
                    opacity: 0;
                }

                50% {
                    transform: scale(1.05) translateX(0);
                }

                100% {
                    transform: scale(1) translateX(0);
                    opacity: 1;
                }
            }

            @keyframes popOut {
                0% {
                    transform: scale(1) translateX(0);
                    opacity: 1;
                }

                100% {
                    transform: scale(0.8) translateX(100%);
                    opacity: 0;
                }
            }

            .agri-progress {
                animation: agriProgress 5s linear forwards;
            }

            @keyframes agriProgress {
                from {
                    width: 100%;
                }

                to {
                    width: 0%;
                }
            }
        </style>
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- FIXED NAVBAR -->
    <nav class="w-full bg-white py-4 px-6 md:px-12 flex justify-between items-center shadow-sm sticky top-0 z-50">
        <div class="flex items-center cursor-pointer">
            <img src="/logo.png" alt="Krushimitra Logo" class="h-12" />
        </div>
        <div class="flex items-center gap-6">
            <a href="/" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Home</a>
            <a href="/about" class="text-brand-green font-bold">About</a>
            <a href="/contact" class="text-gray-600 hover:text-brand-green font-medium hidden md:block">Contact</a>
            <button id="langToggle"
                class="border border-brand-green text-brand-green px-4 py-1 rounded-full text-sm font-medium hover:bg-brand-light transition">
                English / हिंदी
            </button>

            <% if (locals.user) { %>

                <a href="/user/profile" class="flex items-center gap-3 cursor-pointer group">
                    <div class="text-right hidden sm:block">

                    </div>

                    <div
                        class="w-9 h-9 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center font-semibold text-sm group-hover:bg-emerald-200 transition-colors border-2 border-green-900">
                        <% const names=user.fullName.split(' ');
        const initials = names.length > 1 
            ? names[0][0] + names[names.length - 1][0] 
            : names[0].slice(0, 2);
    %>
    <%= initials.toUpperCase() %>
</div>
                </a>
                <% } else { %>
                    <!-- Show login button when not logged in -->
                    <a href="/user/signin"
                        class="bg-brand-green text-white px-6 py-2 rounded-lg font-medium hover:bg-brand-dark transition shadow-lg shadow-emerald-200 inline-block text-center">
                        Login
                    </a>
                    <% } %>
        </div>
    </nav>
        <div id="agri-alerts" class="fixed top-4 right-4 z-[100] space-y-3 w-[360px] max-w-[90vw]">


        <!-- Error Alert -->
        <% if (locals.error) { %>
            <div id="agri-error"
                class="bg-white rounded-xl shadow-xl border-2 border-red-200 overflow-hidden transform transition-all duration-300"
                role="alert" style="animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)">

                <!-- Header with icon -->
                <div
                    class="bg-gradient-to-r from-red-50 to-red-100 px-4 py-3 border-b border-red-200 flex items-center">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center shadow-sm">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <p class="ml-3 text-sm font-bold text-red-900">Request Failed</p>
                    <button onclick="removeAlert(' agri-error')"
                            class="ml-auto text-red-400 hover:text-red-600 focus:outline-none">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            </button>
                    </div>

                    <!-- Content -->
                    <div class="px-4 py-3">
                        <p class="text-sm text-gray-700">
                            <%= locals.error %>
                        </p>
                    </div>

                    <!-- Progress bar -->
                    <div class="h-1 bg-red-500 agri-progress"></div>
        </div>
        <% } %>

            <!-- Success Alert -->
            <% if (locals.success) { %>
                <div id="agri-success"
                    class="bg-white rounded-xl shadow-xl border-2 border-emerald-200 overflow-hidden transform transition-all duration-300"
                    role="alert" style="animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)">

                    <!-- Header with icon -->
                    <div
                        class="bg-gradient-to-r from-emerald-50 to-green-100 px-4 py-3 border-b border-emerald-200 flex items-center">
                        <div class="w-8 h-8 bg-emerald-600 rounded-lg flex items-center justify-center shadow-sm">
                            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <p class="ml-3 text-sm font-bold text-emerald-900">Success!</p>
                        <button onclick="removeAlert('agri-success')"
                            class="ml-auto text-emerald-400 hover:text-emerald-600 focus:outline-none">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>

                    <!-- Content -->
                    <div class="px-4 py-3">
                        <p class="text-sm text-gray-700">
                            <%= locals.success %>
                        </p>
                    </div>

                    <!-- Progress bar -->
                    <div class="h-1 bg-emerald-600 agri-progress"></div>
                </div>
                <% } %>

                    </div>

